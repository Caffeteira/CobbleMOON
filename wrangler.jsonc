{
  "name": "cobblemoon",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {"directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "STORE", "class_name": "Store"}]},
  "migrations": [{"tag": "commerce-v1", "new_sqlite_classes": ["Store"]}]
}
