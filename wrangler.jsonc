{
  "name": "cobblemoon",
  "keep_vars": true,
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "Store"
      }
    ]
  },
  "migrations": [
    {
      "tag": "commerce-v1",
      "new_sqlite_classes": [
        "Store"
      ]
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cobblemoon.shop/*",
      "zone_name": "cobblemoon.shop"
    }
  ]
}
